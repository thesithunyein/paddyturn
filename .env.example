# --- Workspace forecast (server-side, paid from Anjoman testnet escrow) ---
# Anjoman API key. Keep server-side. https://anjoman.ai/docs/using/api-keys
TELEGRAPH_API_KEY=
# Locally generated random secret of at least 24 bytes. Share privately with reviewers.
LOCAL_FORECAST_TOKEN=
# Maximum budget per forecast request, in USD. Testnet allows 0.01 to 0.26.
TELEGRAPH_MAX_SPEND_USD=0.10
# Maximum spend per UTC day for this server instance. Keep escrow small as the real backstop.
TELEGRAPH_DAILY_BUDGET_USD=1
# Live ranked testnet weather intent. Change only after discovering an active provider.
TELEGRAPH_INTENT=WEATHER_FORECAST_GENERAL

# --- x402 probe (npm run probe -- --buy) ---
# Dedicated Ethereum Sepolia wallet funded with test USDC. Never a real wallet.
SEPOLIA_PRIVATE_KEY=
# Per-payment cap in millionths of test USDC (10000 = $0.01).
MAX_TEST_MICRO_USDC=10000
# Leave empty to use the best-ranked active miner from discovery. Pin only to reproduce a specific run.
TELEGRAPH_MINER_ID=
# Optional place name for the probe. Defaults to Pathein, Myanmar.
PROBE_LOCATION=

# --- Mill workspaces and shared daily budget (optional) ---
# Set automatically when you connect "Upstash for Redis" to the project in Vercel (Storage tab).
# Without them, workspaces stay in each browser and the daily budget is per server instance.
KV_REST_API_URL=
KV_REST_API_TOKEN=
