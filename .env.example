# Anjoman API key for the workspace forecast. Keep server-side.
TELEGRAPH_API_KEY=
# Maximum testnet escrow spend per forecast. Do not remove this cap.
TELEGRAPH_MAX_SPEND_USD=0.30

# Dedicated Ethereum Sepolia wallet funded with test USDC.
SEPOLIA_PRIVATE_KEY=
# Use a locally generated random secret of at least 24 bytes.
LOCAL_FORECAST_TOKEN=
MAX_TEST_MICRO_USDC=10000
TELEGRAPH_MINER_ID=4433
# Telegraph's live testnet weather-forecast intent. Change this only after
# discovering a compatible, active provider.
TELEGRAPH_INTENT=WEATHER_FORECAST_GENERAL
